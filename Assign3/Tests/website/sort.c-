// C-F26
//   A program to perform simple selection sort of
// up to a 10 element array
int size;
int x[10];


int minloc(int a[]; int low; int high)
{
    int i;
    int x;
    int k;

    k = low;
    x = a[low];
    i = low + 1;

    while i<high do {
        if a[i]<x then {
            x = a[i];
            k = i;
        }
        i += 1;
    }

    return k;
}



sort(int a[]; int low, high)
{
    int i;
    int k;

    i = low;
    while i<high - 1 do {
        int t;

        k = minloc(a, i, high);
        t = a[k];
        a[k] = a[i];
        a[i] = t;
        i = i + 1;
    }
}



main()
{
    int i;

    size = input();

    i = 0;
    while i<size do {
        x[i] = input();
        i += 1;
    }

    sort(x, 0, size);

    i = 0;
    while i<size do {
        output(x[i]);
        i += 1;
    }
}