// C-S21
char gx, gy[10];    // global 

esperanza(char px, py[])   // local
{
    char x, y[10];  // local 
    static char sx, sy[10];     // global 

    gx = 'a';
    outputc(gx);
    gy[9] = 'b';
    outputc(gy[9]);
    x = 'c';
    outputc(x);
    y[9] = 'd';
    outputc(y[9]);
    outnl();
    px = 'e';
    outputc(px);
    py[9] = 'f';
    outputc(py[9]);
    sx = 'f';
    outputc(sx);
    sy[9] = 'h';
    outputc(sy[9]);
    outnl();
}


main()
{
    char zx, zy[10];
    esperanza(zx, zy);
}
