// Global declarations, with and without initializers
int x : 10;
bool flag : true;
char c : 'A';
int arr[5];

// Simple function with two params of the same type
int add(int a, b)
{
    return a + b;
}

// Function with a local (non-static) scoped var decl and a while loop
int factorial(int n)
{
    int result : 1;

    while n > 0 do
    {
        result = result * n;
        n = n - 1;
    }

    return result;
}

int main()
{
    // static local var decl, array
    static int localArr[5];
    int i;
    int sum : 0;
    bool isEven;

    // for ... to ... by
    for i = 0 to 4 by 1 do
        localArr[i] = i * 2;

    // for ... to (no by)
    for i = 0 to 4 do
        sum = sum + localArr[i];

    // matched if/then/else, single statements
    if sum > 20 then
        isEven = true;
    else
        isEven = false;

    // matched if/then/else, compound statements + inc/dec
    if isEven then
    {
        sum++;
    }
    else
    {
        sum--;
    }

    // parens, and/or/not, min/max ops (<<, >>)
    if (sum >= 100 and flag) or not isEven then
        sum = sum << 2;
    else
        sum = sum >> 1;

    // while/do with a dangling if (unmatchedStmt) and break
    i = 0;
    while i < 5 do
    {
        if i == 3 then
            break;
        i++;
    }

    // compound assignment operators
    x += factorial(5);
    x -= 1;
    x *= 2;
    x /= 3;

    // char constant, unary star, unary minus, unary question (random)
    c = 'B';
    flag = *localArr;
    x = -x;
    sum = ?100;

    // string constant as a bare expression statement
    "hello";

    // function call as a statement
    add(x, sum);

    return 0;
}
