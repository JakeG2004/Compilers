Grammar

    0 $accept: program $end

    1 program: declList

    2 declList: declList decl
    3         | decl

    4 decl: varDecl
    5     | funDecl

    6 varDecl: typeSpec varDeclList SEMICOLON

    7 scopedVarDecl: STATIC typeSpec varDeclList SEMICOLON
    8              | typeSpec varDeclList SEMICOLON

    9 varDeclList: varDeclList COMMA varDeclInit
   10            | varDeclInit

   11 varDeclInit: varDeclId
   12            | varDeclId COLON simpleExp

   13 varDeclId: ID
   14          | ID LBRACKET NUMCONST RBRACKET

   15 typeSpec: INT
   16         | BOOL
   17         | CHAR

   18 funDecl: typeSpec ID LPAREN parms RPAREN stmt
   19        | ID LPAREN parms RPAREN stmt

   20 parms: parmList
   21      | ε

   22 parmList: parmList SEMICOLON parmTypeList
   23         | parmTypeList

   24 parmTypeList: typeSpec parmIdList

   25 parmIdList: parmIdList COMMA parmId
   26           | parmId

   27 parmId: ID
   28       | ID LPAREN RPAREN

   29 stmt: selectStmt

   30 otherStmts: expStmt
   31           | compoundStmt
   32           | returnStmt
   33           | breakStmt

   34 expStmt: exp SEMICOLON
   35        | SEMICOLON

   36 compoundStmt: LBRACE localDecls stmtList RBRACE

   37 localDecls: localDecls scopedVarDecl
   38           | ε

   39 stmtList: stmtList stmt
   40         | ε

   41 selectStmt: matchedStmt
   42           | unmatchedStmt

   43 matchedStmt: IF simpleExp THEN matchedStmt ELSE matchedStmt
   44            | WHILE simpleExp DO matchedStmt
   45            | FOR ID ASSIGN iterRange DO matchedStmt
   46            | otherStmts

   47 unmatchedStmt: IF simpleExp THEN selectStmt
   48              | IF matchedStmt ELSE unmatchedStmt
   49              | WHILE simpleExp DO unmatchedStmt
   50              | FOR ID ASSIGN iterRange DO unmatchedStmt

   51 iterRange: simpleExp
   52          | simpleExp TO simpleExp
   53          | simpleExp TO simpleExp BY simpleExp

   54 returnStmt: RETURN SEMICOLON
   55           | RETURN exp SEMICOLON

   56 breakStmt: BREAK SEMICOLON
   57          | BREAK exp SEMICOLON

   58 exp: mutable ASSIGN exp
   59    | mutable ADDASS exp
   60    | mutable SUBASS exp
   61    | mutable MULASS exp
   62    | mutable DIVASS exp
   63    | mutable INC
   64    | mutable DEC
   65    | simpleExp

   66 simpleExp: simpleExp OR andExp
   67          | andExp

   68 andExp: andExp AND unaryRelExp
   69       | unaryRelExp

   70 unaryRelExp: NOT unaryRelExp
   71            | relExp

   72 relExp: minmaxExp relop minmaxExp
   73       | minmaxExp

   74 relop: LEQ
   75      | LT
   76      | GT
   77      | GEQ
   78      | EQ
   79      | NEQ

   80 minmaxExp: minmaxExp minmaxop sumExp
   81          | sumExp

   82 minmaxop: MIN
   83         | MAX

   84 sumExp: sumExp sumop mulExp
   85       | mulExp

   86 sumop: PLUS
   87      | MINUS

   88 mulExp: mulExp mulop unaryExp
   89       | unaryExp

   90 mulop: STAR
   91      | DIVIDE
   92      | MOD

   93 unaryExp: unaryop unaryExp
   94         | factor

   95 unaryop: MINUS
   96        | STAR
   97        | QUESTION

   98 factor: immutable
   99       | mutable

  100 mutable: ID
  101        | ID LBRACKET exp RBRACKET

  102 immutable: LPAREN exp RPAREN
  103          | call
  104          | constant

  105 call: ID LPAREN args RPAREN

  106 args: argList
  107     | ε

  108 argList: argList COMMA exp
  109        | exp

  110 constant: NUMCONST
  111         | CHARCONST
  112         | STRINGCONST
  113         | TRUE
  114         | FALSE


