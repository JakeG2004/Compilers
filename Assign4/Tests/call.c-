twoParms(int a, b)
{
    a;
    b;
}

arrFunc(int a[])
{
    a[0];
}

main()
{
    int x[10];

    twoParms(1, 2); // should work
    twoParms(1, 2, 3); // too many
    twoParms(1); // too few

    twoParms('a'); // wrong Type
    twoParms(x); // array when Not Expecting

    arrFunc(x); // should work
    arrFunc(1); // not array when expecting
}