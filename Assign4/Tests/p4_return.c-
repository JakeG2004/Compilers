// C-F26 a4: return checks
noRet()
{
    return 1;                   // ERR no value expected
}

int needVal()
{
    return;                     // ERR value expected
}

int wrongType()
{
    return 'a';                 // ERR returns char
}

bool wrongBool()
{
    return 1;                   // ERR returns int
}

char okChar()
{
    return 'x';
}

int noReturnStmt()              // WARN no return statement
{
}

fall()
{
}

fine()
{
    return;
}

int undef()
{
    return nope;                // ERR undeclared only
}

int nested(int x)
{
    if x > 0 then return 1;
    else return 2;
}

main()
{
    noRet();
    needVal();
    wrongType();
    wrongBool();
    okChar();
    noReturnStmt();
    fall();
    fine();
    undef();
    nested(1);
}
