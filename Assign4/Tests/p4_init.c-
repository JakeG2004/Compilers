// C-F26 a4: initialization errors
int gi : 1;
bool gb : true;
char gc : 'c';
int gArr[10];
int gBad : gi;                      // ERR not constant
int gBadExpr : gi + 1;              // ERR not constant
int gConst : 2 * 3 + 1 - -4;
bool gConstB : not false and true;
bool gCmp : 1 < 2;
int gIdx : gArr[2];                 // ERR not constant

main()
{
    int a : 'c';                    // ERR int/char
    bool b : 1;                     // ERR bool/int
    char c : true;                  // ERR char/bool
    int d : 1 < 2;                  // ERR int/bool
    int e[10] : 1;                  // ERR array vs nonarray
    int f : gArr;                   // ERR nonarray vs array
    int h[10] : gArr;
    char i[10] : gArr;              // ERR char/int
    int j : nope;                   // ERR undeclared only
    static int k : gi;              // ERR not constant
    static int l : 5;
    int m : gi;                     // ERR not constant
    int n : 4 * (2 + 3);

    gi; gb; gc; gBad; gBadExpr; gConst; gConstB; gCmp; gIdx; gArr[0];
    a; b; c; d; e[0]; f; h[0]; i[0]; j; k; l; m; n;
}
