// C-F26 a4: undefined types must not cascade
int f()
{
    return nope8;               // ERR undeclared only
}

main()
{
    int n : 1;

    n = nope1 + 2;              // ERR undeclared only
    if nope2 then n = 1;        // ERR undeclared only
    while nope3 do n = 2;       // ERR undeclared only
    output(nope4);              // ERR undeclared only
    n = 3 * nope5 - 1;          // ERR undeclared only
    n = f() + nope6;            // ERR undeclared only
    n = -nope7;                 // ERR undeclared only
    n;
}
