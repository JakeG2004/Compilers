// C-F26 a4: call checking
int g[10];

twoParms(int a, b)
{
    a;
    b;
}

arrFunc(int a[])
{
    a[0];
}

charFunc(char c)
{
    c;
}

main()
{
    int s : 1;

    twoParms(1, 2);
    twoParms(1, 2, 3);          // ERR too many
    twoParms(1);                // ERR too few
    twoParms('a', 2);           // ERR param 1 char
    twoParms(1, true);          // ERR param 2 bool
    twoParms(g, 2);            // ERR not expecting array param 1
    arrFunc(g);
    arrFunc(s);                 // ERR expecting array param 1
    charFunc('x');
    charFunc(s);                // ERR param 1 int
    twoParms(nope, 2);          // ERR undeclared only
    s();                        // ERR simple variable cannot be called (nothing else)
}
