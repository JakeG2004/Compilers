// C-F26 a4: a call has the return type of the function
int fi()
{
    return 1;
}

char fc()
{
    return 'a';
}

bool fb()
{
    return true;
}

main()
{
    int n : 0;

    n = fi();
    n = fc();                   // ERR int = char
    n = fi() + fb();            // ERR rhs of + is bool
    if fb() then n = 1;
    if fi() then n = 2;         // ERR test condition int
    for k = fc() to 3 do k;     // ERR range pos 1 char
    output(fc());               // ERR param 1 wants int
}
